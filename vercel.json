{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "//": "Confirmar un pedido lee productos.json (1.4 MB) y lo reescribe con un PUT de 1.9 MB en base64: 5-11 s en total, contra el limite POR DEFECTO de 10 s -> se cortaba a la mitad y el pedido quedaba pendiente. Con 60 s hay margen de sobra. OJO: se listan los archivos UNO POR UNO, no 'api/*.js': ese patron tambien agarra api/_lib.js, que Vercel NO considera una funcion (empieza con guion bajo) y el build falla.",
  "functions": {
    "api/pedido.js": { "maxDuration": 60 },
    "api/pedidos.js": { "maxDuration": 60 },
    "api/pedido-accion.js": { "maxDuration": 60 },
    "api/reservas.js": { "maxDuration": 60 }
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },

    { "source": "/assets/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/css/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/js/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },

    { "source": "/(productos|cartas).json", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
